{
  "name": "react-native-reflow-grid",
  "version": "0.2.0",
  "description": "A windowed, animated grid for React Native: items glide into place when added, removed or re-laid-out, and multi-touch presses never get dropped.",
  "keywords": [
    "react-native",
    "grid",
    "layout",
    "animation",
    "reanimated",
    "virtualized",
    "ios",
    "android"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradenacurtis801/react-native-reflow-grid.git"
  },
  "homepage": "https://github.com/bradenacurtis801/react-native-reflow-grid#readme",
  "bugs": {
    "url": "https://github.com/bradenacurtis801/react-native-reflow-grid/issues"
  },
  "author": "Braden Curtis",
  "source": "./src/index.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "files": [
    "src",
    "!src/**/__tests__",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "peerDependencies": {
    "react": ">=19.2",
    "react-native": ">=0.85",
    "react-native-reanimated": ">=4.3",
    "react-native-worklets": ">=0.8",
    "expo-haptics": "*"
  },
  "peerDependenciesMeta": {
    "expo-haptics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^19.0.0",
    "jest": "^29.7.0",
    "react": "^19.2.3",
    "react-native": "^0.85.3",
    "react-native-reanimated": "^4.3.1",
    "react-native-worklets": "^0.8.3",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
